{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "consistency_review_input.v1",
  "type": "object",
  "required": ["candidate_id", "revision_id", "question", "evidence", "quality_result", "prescreen_result"],
  "properties": {
    "candidate_id": {"type": "string", "minLength": 1},
    "revision_id": {"type": "string", "minLength": 1},
    "question": {"type": "string", "minLength": 1},
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["citation", "text", "text_hash"],
        "properties": {
          "citation": {"type": "string", "minLength": 1},
          "text": {"type": "string", "minLength": 1},
          "text_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        },
        "additionalProperties": false
      }
    },
    "quality_result": {"type": "object"},
    "prescreen_result": {"type": "object"}
  },
  "additionalProperties": false
}
